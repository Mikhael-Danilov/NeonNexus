# systemd unit for the Neon Nexus entitlement service (VK votes IAP, `noads`).
# Deployed form (VPS ru.nyrds.net, same layout as chinese-quiz-api):
#   sudo cp deploy/neonnexus-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now neonnexus-api
#
# Setup (dev.vk.com → the mini app):
#   - «Настройки» → «Ключи доступа»: copy «защищённый ключ» and «сервисный
#     ключ» into /var/www/neon-nexus-api/backend/.env as VK_APP_SECRET and
#     VK_SERVICE_TOKEN (chmod 600, owner nyrds; the unit loads that file).
#     VK_APP_ID (54802003) is set below.
#   - «Настройки» → «URL для платёжных уведомлений ВКонтакте»:
#       https://ru.nyrds.net/neon-nexus/api/vk/order
#   The order state lives in NN_DATA_DIR/entitlements.json (default: the
#   working directory) — keep it on the ReadWritePaths side.

[Unit]
Description=Neon Nexus entitlement API (VK IAP noads)
After=network.target

[Service]
User=nyrds
Group=nyrds
WorkingDirectory=/var/www/neon-nexus-api/backend
Environment=NN_DATA_DIR=/var/www/neon-nexus-api/backend
Environment=VK_APP_ID=54802003
EnvironmentFile=/var/www/neon-nexus-api/backend/.env
ExecStart=/var/www/neon-nexus-api/backend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8017
Restart=on-failure
RestartSec=3

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/neon-nexus-api/backend

[Install]
WantedBy=multi-user.target
